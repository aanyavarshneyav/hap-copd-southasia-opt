# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Raw, interim, and large processed data (never commit raw exports or large artifacts)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/*_mock.*

# Large outputs and saved model weights
outputs/models/*
!outputs/models/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep

# Notebooks checkpoints
.ipynb_checkpoints/

# OS & editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
