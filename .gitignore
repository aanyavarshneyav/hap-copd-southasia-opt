# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Raw, interim, and large processed data (never commit raw exports or large archives)
data/raw/*
!data/raw/.gitkeep
!data/raw/manifest.json
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/*_mock.*
!data/processed/forecasts_stage3.csv
!data/processed/forecasts_stage3.csv.meta.json
!data/processed/baseline_unit_state.csv
!data/processed/baseline_unit_state.csv.meta.json
!data/processed/exposure_response_surrogate.json
!data/processed/stage2_uncertainty_draws.csv

# Outputs and figures
outputs/models/*
!outputs/models/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
!outputs/figures/*.png
outputs/tables/*
!outputs/tables/.gitkeep
!outputs/tables/*.csv

# Notebooks checkpoints
.ipynb_checkpoints/

# OS & editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
